Algoritmo PromedioNotas
	
    Definir nota1, nota2, nota3, Promedio Como Real
	
    Escribir "Escribe nota 1: "
    Leer nota1
	
    Escribir "Escribe nota 2: "
    Leer nota2
	
    Escribir "Escribe nota 3: "
    Leer nota3
	
    Promedio <- (nota1 + nota2 + nota3) / 3
	
    Escribir "Su promedio es: ", Promedio
	
FinAlgoritmo
